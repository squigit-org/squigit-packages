[squigit-ocr]
name=Squigit OCR Packages
baseurl=https://squigit-org.github.io/squigit-distribution/rpm/ocr
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://squigit-org.github.io/squigit-distribution/keys/squigit-distribution.asc

[squigit-cli]
name=Squigit CLI Packages
baseurl=https://squigit-org.github.io/squigit-distribution/rpm/cli
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://squigit-org.github.io/squigit-distribution/keys/squigit-distribution.asc
